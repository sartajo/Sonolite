// Carrier code for the servo to receive a signal from the computer to move to a specific angle
// I: int angleNumber (between 0 and 180 degrees)
// O: null
#include <Servo.h>

Servo ultrasoundServo;  // Create servo object to control a servo

// Define the pin where the servo signal wire is connected
const int servoPin = 9;

int inputAngle = 0;

void setup() {
  ultrasoundServo.attach(servoPin);  // Attaches the servo on pin 9 to the servo object
  Serial.begin(9600);                // Open serial for debugging
  
  // Move to 0 position immediately
  ultrasoundServo.write(0);
  delay(1000); // Give it a second to get to the start position
}

void loop() {
  
  if (Serial.available() > 0){
    inputAngle = Serial.parseInt();

    // The angle is forced to stay within the angle limits
    if (inputAngle > 180){
      inputAngle = 180;
    }
    else if (inputAngle < 0){
      inputAngle = 0;
    }

    // Serial.println(inputAngle); // debugging

    // write the angle to the servo
    ultrasoundServo.write(inputAngle);
  }
}
